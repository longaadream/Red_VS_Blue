{
  "appId": "com.redvsblue.server",
  "productName": "RED vs BLUE Server",
  "directories": { "output": "dist/server-latest" },
  "files": [
    "electron/dist/**",
    "electron/dashboard/**",
    "node_modules/adm-zip/**"
  ],
  "extraResources": [
    { "from": "_standalone",       "to": "app/standalone" },
    { "from": "public",            "to": "app/public" },
    { "from": "data",              "to": "app/data" },
    { "from": "prisma",            "to": "app/prisma" },
    { "from": "scripts/init-db.js","to": "app/init-db.js" }
  ],
  "win": {
    "target": "portable"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "tar.gz", "arch": ["x64"] }
    ]
  }
}
