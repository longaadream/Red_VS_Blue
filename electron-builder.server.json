{
  "appId": "com.redvsblue.server",
  "productName": "RED vs BLUE Server",
  "directories": { "output": "dist/server-build" },
  "extraMetadata": {
    "main": "electron/dist/main.js"
  },
  "files": [
    "electron/dist/**",
    "electron/dashboard/**",
    "package.json",
    "!node_modules/**"
  ],
  "extraResources": [
    { "from": "_client-stage", "to": "app/standalone" },
    { "from": "public", "to": "app/public" },
    { "from": "data", "to": "app/data" },
    { "from": "prisma", "to": "app/prisma" },
    { "from": "scripts/init-db.js", "to": "app/init-db.js" },
    { "from": "node_modules/adm-zip", "to": "app/node_modules/adm-zip" },
    { "from": "_client-node/node.exe", "to": "node.exe" }
  ],
  "asar": false,
  "win": {
    "target": "dir"
  }
}
