generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Room {
  id                            String   @id
  name                          String
  status                        String   @default("waiting")
  mapId                         String?
  hostId                        String?
  visibility                    String?
  maxPlayers                    Int?
  players                       String   @default("[]")
  spectators                    String   @default("[]")
  battleState                   String?
  inviteCode                    String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  version                       Int      @default(0)
  battleAuthorityVersion        Int      @default(0)
  battleAuthorityTransitionHash String   @default("")
}

model GameRecord {
  id             String   @id @default(cuid())
  playerId       String
  playerName     String
  opponentId     String?
  opponentName   String?
  result         String // "win" | "loss"
  turns          Int
  myPieces       String // JSON: [{templateId, name}]
  opponentPieces String // JSON: [{templateId, name}]
  roomId         String?
  mapId          String?
  createdAt      DateTime @default(now())
}

model BattleAuthorityTransition {
  roomId                 String
  fromVersion            Int
  toVersion              Int
  protocolVersion        Int
  clientActionId         String
  playerId               String
  commandJson            String
  internalPatch          String
  publicPatch            String
  preStateHash           String
  postStateHash          String
  prePublicHash          String
  postPublicHash         String
  actionHash             String
  previousTransitionHash String
  transitionHash         String
  pendingJson            String?
  traceJson              String?
  replayFrameJson        String?
  createdAt              DateTime @default(now())

  @@id([roomId, toVersion])
  @@unique([roomId, clientActionId])
  @@index([roomId, fromVersion])
}

model BattleAuthorityReceipt {
  roomId           String
  clientActionId   String
  status           String
  authorityVersion Int
  code             String?
  message          String?
  receiptJson      String
  createdAt        DateTime @default(now())

  @@id([roomId, clientActionId])
  @@index([roomId, authorityVersion])
}

model BattleAuthorityCheckpoint {
  roomId           String
  authorityVersion Int
  protocolVersion  Int
  seed             Int
  stateJson        String
  stateHash        String
  publicHash       String
  transitionHash   String
  reason           String
  createdAt        DateTime @default(now())

  @@id([roomId, authorityVersion])
  @@index([roomId, createdAt])
}
