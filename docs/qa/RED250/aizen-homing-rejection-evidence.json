argetSelection)return t;if(c.x!==t.x&&c.y!==t.y)return {success:false,message:'请选择正方向内的敌人'};var cells=[[0,-1],[1,0],[0,1],[-1,0]],candidates=[];for(var i=0;i<cells.length;i++){var x=t.x+cells[i][0],y=t.y+cells[i][1],tile=b.map.tiles.find(function(q){return q.x===x&&q.y===y;});if(tile&&tile.props.walkable&&!b.pieces.some(function(p){return p.currentHp>0&&p.x===x&&p.y===y;}))candidates.push({x:x,y:y});}if(!candidates.length)return {success:false,message:'目标相邻地格没有合法落点'};var dest=flow.query.random(candidates);if(!dest)return {success:false,message:'目标相邻地格没有合法落点'};if (!flow.effects.move([{pieceId:c.instanceId,x:dest.x,y:dest.y}], 'teleport').success) return {success:true,message:'位移被阻挡，本次位移效果取消'};var r=dealDamage(c,t,c.attack*0.5+Math.floor((c.momentum||0)/4),'physical',b,context.skill.id);return {success:true,message:'追踪攻击造成'+r.damage+'点伤害'};}","targetText":"正方向内敌人（4）"},"viewer":"training-red"}
