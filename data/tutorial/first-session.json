      "advance": { "type": "continue" },
      "cue": { "templates": ["uther", "reaper"] }
    },
    {
      "id": "review-defense",
      "scene": 1,
      "sceneTitle": "社团开场",
      "speaker": "社长 / DM",
      "text": "刚才死神开了一枪。乌瑟尔有防御，所以没把纸面伤害全吃下去。点右边那条“地狱火霰弹枪”，棋盘会把来源和目标重新标出来。",
      "objective": "点击右侧“地狱火霰弹枪”，回看这次攻击",
      "advance": { "type": "history-item", "labelIncludes": "地狱火霰弹枪" },
      "cue": { "templates": ["reaper", "uther"], "connectTemplates": ["reaper", "uther"] }
    },
    {
      "id": "deploy-anduin",
      "scene": 2,
      "sceneTitle": "新成员上桌",
      "speaker": "社长 / DM",
      "text": "每个自己的回合开始时，先从候选里派一名后备棋子上场。你第一个自己的回合有 1 点基础行动点；以后每次再轮到你，上限都会加 1，最多 10 点，并在回合开始补满。剩下的不会带到下回合，别想着攒到期末。今晚先让安度因来——治疗位通常比嘴硬靠谱。",
      "objective": "选择安度因，并部署到绿色标记格",
      "advance": { "type": "action", "actionType": "deployReservePiece", "templateId": "anduin", "to": { "x": 5, "y": 1 } },
      "cue": { "cells": [{ "x": 5, "y": 1 }] }
    },
    {
      "id": "play-lucky-coin",
      "scene": 2,
      "sceneTitle": "新成员上桌",
      "speaker": "社长 / DM",
      "text": "后手多一枚幸运币，打出去能补 1 点行动点。放心，这不是社费报销，是规则真的允许。",
      "objective": "点击幸运币，再次点击确认打出",
      "advance": { "type": "action", "actionType": "playCard", "cardId": "lucky-coin" }
    },
    {
